#!/usr/bin/env bash
set -euo pipefail

# Empty CDPATH applies only to the cd command.
# shellcheck disable=SC1007
root_dir="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
session="${1:-codex}"

if [ -n "${ALACRITTY_WINDOW_ID:-}" ]; then
  exec "$root_dir/bin/tmux" new-session -A -s "$session"
fi

exec "$root_dir/bin/alacritty" --title "tmux:$session" --command "$root_dir/bin/tmux" new-session -A -s "$session"
