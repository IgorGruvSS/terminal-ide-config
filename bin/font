#!/usr/bin/env bash
set -euo pipefail

root_dir="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
config_file="$root_dir/alacritty/alacritty.toml"

list_fonts() {
  fc-list :spacing=100 --format '%{family[0]}\n' | sort -fu
}

usage() {
  cat <<'EOF'
Usage:
  font <font family>  Preview a monospaced font in the current Alacritty window
  font list           List the font families available for completion
  font current        Show the font used by the current Alacritty window
  font save           Save the current font as the default
  font reset          Return to the font configured in alacritty.toml
EOF
}

current_font() {
  alacritty msg get-config |
    sed -n 's/.*"font":{.*"normal":{"family":"\([^"]*\)".*/\1/p'
}

save_font() {
  local family toml_family temp_file

  family="$(current_font)"
  if [ -z "$family" ]; then
    printf 'Could not read the current Alacritty font.\n' >&2
    exit 1
  fi

  toml_family="${family//\\/\\\\}"
  toml_family="${toml_family//\"/\\\"}"
  temp_file="$(mktemp "$config_file.tmp.XXXXXX")"

  if ! awk -v family="$toml_family" '
    /^\[/ {
      in_font_style = ($0 ~ /^\[font\.(normal|bold|italic|bold_italic)\]$/)
    }

    in_font_style && /^[[:space:]]*family[[:space:]]*=/ {
      print "family = \"" family "\""
      updated = 1
      next
    }

    { print }

    END {
      if (!updated) {
        exit 1
      }
    }
  ' "$config_file" > "$temp_file"; then
    rm -f "$temp_file"
    printf 'Could not update font families in %s.\n' "$config_file" >&2
    exit 1
  fi

  chmod --reference="$config_file" "$temp_file"
  mv "$temp_file" "$config_file"

  printf 'Default font saved: %s\n' "$family"
  printf 'New Alacritty windows will use this font.\n'
}

select_font() {
  local requested="$1"
  local family

  family="$(list_fonts | awk -v requested="$requested" '
    tolower($0) == tolower(requested) {
      print
      exit
    }
  ')"

  if [ -z "$family" ]; then
    printf 'Unknown monospaced font: %s\n' "$requested" >&2
    printf 'Run "font list" or use zsh completion after "font ".\n' >&2
    exit 1
  fi

  alacritty msg config \
    "font.normal.family=\"$family\"" \
    "font.bold.family=\"$family\"" \
    "font.italic.family=\"$family\"" \
    "font.bold_italic.family=\"$family\""

  printf 'Temporary font: %s\n' "$family"
  printf 'Run "font reset" to restore alacritty.toml.\n'
}

if ! command -v fc-list >/dev/null; then
  printf 'fc-list not found. Install it with: sudo dnf install fontconfig\n' >&2
  exit 1
fi

case "${1-}" in
  "")
    usage
    ;;
  list | --list)
    list_fonts
    ;;
  current | --current)
    current_font
    ;;
  save | --save)
    save_font
    ;;
  reset | --reset)
    alacritty msg config --reset
    printf 'Font restored from alacritty.toml.\n'
    ;;
  -h | --help | help)
    usage
    ;;
  *)
    select_font "$*"
    ;;
esac
