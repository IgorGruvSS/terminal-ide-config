#!/usr/bin/env bash
set -euo pipefail

root_dir="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
session_file="${1:-$root_dir/.state/kitty/sessions/last.conf}"
socket="${KITTY_LISTEN_ON:-unix:/tmp/kitty-dev}"

mkdir -p "$(dirname "$session_file")"

tmp_file="$(mktemp)"
trap 'rm -f "$tmp_file"' EXIT

"$root_dir/bin/kitty" @ --to "$socket" ls --output-format=session > "$tmp_file"
mv "$tmp_file" "$session_file"

printf 'Saved kitty session to %s\n' "$session_file"
