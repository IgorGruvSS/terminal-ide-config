#!/usr/bin/env bash
set -euo pipefail

root_dir="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
nvim_bin="$root_dir/.local/bin/nvim"
export XDG_CONFIG_HOME="$root_dir"
export XDG_DATA_HOME="$root_dir/.local/share"
export XDG_STATE_HOME="$root_dir/.local/state"
export XDG_CACHE_HOME="$root_dir/.cache"

if [ -x "$nvim_bin" ]; then
  exec "$nvim_bin" "$@"
fi

for candidate in /usr/local/bin/nvim /usr/bin/nvim; do
  if [ -x "$candidate" ]; then
    exec "$candidate" "$@"
  fi
done

printf 'Neovim not found. Run: %s/install.sh\n' "$root_dir" >&2
exit 1
