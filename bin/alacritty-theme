#!/usr/bin/env bash
set -euo pipefail

root_dir="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
theme_dir="$root_dir/alacritty/themes"
state_dir="$root_dir/.local/state"
state_file="$state_dir/alacritty-theme"
active_theme="$theme_dir/active.toml"

profiles=(aura alabaster modus flexoki github catppuccin)

usage() {
  cat <<'EOF'
Usage: alacritty-theme <command> [arguments]

Commands:
  list                 List the available theme profiles and palettes.
  current              Show the selected profile and color mode.
  set <profile> <mode> Select a profile in light or dark mode.
  system               Apply the KDE light/dark preference using the selected profile.

Examples:
  alacritty-theme set alabaster light
  alacritty-theme set modus dark
  alacritty-theme system
EOF
}

is_profile() {
  local candidate="$1" profile
  for profile in "${profiles[@]}"; do
    [ "$candidate" = "$profile" ] && return 0
  done
  return 1
}

read_state() {
  if [ -r "$state_file" ]; then
    sed -n '1,2p' "$state_file"
  else
    printf 'aura\nlight\n'
  fi
}

palette_path() {
  local profile="$1" mode="$2"
  if [ "$profile" = aura ]; then
    case "$mode" in
      light) printf '%s\n' "$theme_dir/aura-light-theme.toml" ;;
      dark) printf '%s\n' "$theme_dir/aura-theme.toml" ;;
    esac
    return
  fi

  printf '%s\n' "$theme_dir/$profile-$mode.toml"
}

write_state() {
  local profile="$1" mode="$2" temporary
  mkdir -p "$state_dir"
  temporary="$(mktemp "$state_dir/.alacritty-theme.XXXXXX")"
  printf '%s\n%s\n' "$profile" "$mode" > "$temporary"
  mv "$temporary" "$state_file"
}

set_theme() {
  local profile="$1" mode="$2" source temporary
  source="$(palette_path "$profile" "$mode")"
  if [ ! -r "$source" ]; then
    printf 'Palette unavailable: %s\n' "$source" >&2
    exit 1
  fi

  temporary="$(mktemp "$theme_dir/.active.toml.XXXXXX")"
  cp "$source" "$temporary"
  mv "$temporary" "$active_theme"
  write_state "$profile" "$mode"
  printf 'Selected %s (%s). Alacritty reloads it automatically; Neovim syncs on startup or focus.\n' "$profile" "$mode"
}

case "${1-}" in
  list)
    for profile in "${profiles[@]}"; do
      printf '%s: light=%s, dark=%s\n' "$profile" \
        "$(basename "$(palette_path "$profile" light)")" \
        "$(basename "$(palette_path "$profile" dark)")"
    done
    ;;
  current)
    read_state | paste -sd ' ' - | sed 's/^/Current: /'
    ;;
  set)
    if [ "$#" -ne 3 ] || ! is_profile "$2" || { [ "$3" != light ] && [ "$3" != dark ]; }; then
      usage >&2
      exit 2
    fi
    set_theme "$2" "$3"
    ;;
  system)
    exec "$root_dir/bin/alacritty-theme-sync" --once
    ;;
  -h|--help|help|'')
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
