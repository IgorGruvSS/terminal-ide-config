#!/usr/bin/env bash
set -euo pipefail

root_dir="$(CDPATH=; cd -- "$(dirname -- "$0")/.." && pwd)"
theme_dir="$root_dir/alacritty/themes"
state_dir="$root_dir/.local/state"
state_file="$state_dir/alacritty-theme"
active_theme="$theme_dir/active.toml"

usage() {
  cat <<'EOF'
Usage: alacritty-theme <command> [arguments]

Commands:
  list                 List the Catppuccin palettes.
  current              Show the selected Catppuccin mode.
  set <mode>           Select Catppuccin in light or dark mode.
  system               Apply the KDE light/dark preference.

Examples:
  alacritty-theme set light
  alacritty-theme set dark
  alacritty-theme system
EOF
}

read_mode() {
  if [ -r "$state_file" ]; then
    local first second
    first="$(sed -n '1p' "$state_file")"
    second="$(sed -n '2p' "$state_file")"
    if [ "$first" = catppuccin ]; then
      first="$second"
    fi
    if [ "$first" = light ] || [ "$first" = dark ]; then
      printf '%s\n' "$first"
      return
    fi
  fi
  printf 'light\n'
}

palette_path() {
  local mode="$1"
  printf '%s\n' "$theme_dir/catppuccin-$mode.toml"
}

write_state() {
  local mode="$1" temporary
  mkdir -p "$state_dir"
  temporary="$(mktemp "$state_dir/.alacritty-theme.XXXXXX")"
  printf '%s\n' "$mode" > "$temporary"
  mv "$temporary" "$state_file"
}

set_theme() {
  local mode="$1" source temporary
  source="$(palette_path "$mode")"
  if [ ! -r "$source" ]; then
    printf 'Palette unavailable: %s\n' "$source" >&2
    exit 1
  fi

  temporary="$(mktemp "$theme_dir/.active.toml.XXXXXX")"
  cp "$source" "$temporary"
  mv "$temporary" "$active_theme"
  write_state "$mode"
  printf 'Selected Catppuccin (%s). Alacritty reloads it automatically; Neovim syncs on startup or focus.\n' "$mode"
}

case "${1-}" in
  list)
    printf 'catppuccin: light=%s, dark=%s\n' \
      "$(basename "$(palette_path light)")" \
      "$(basename "$(palette_path dark)")"
    ;;
  current)
    printf 'Current: Catppuccin (%s)\n' "$(read_mode)"
    ;;
  set)
    if [ "$#" -ne 2 ] || { [ "$2" != light ] && [ "$2" != dark ]; }; then
      usage >&2
      exit 2
    fi
    set_theme "$2"
    ;;
  system)
    exec "$root_dir/bin/alacritty-theme-sync" --once
    ;;
  -h|--help|help|'')
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
