#!/usr/bin/env bash
set -euo pipefail

root_dir="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
launcher_path="$(readlink -f "$0")"
alacritty_bin="${ALACRITTY_BIN:-}"

if [ -z "$alacritty_bin" ]; then
  candidate="$(command -v alacritty 2>/dev/null || true)"
  if [ -n "$candidate" ] && [ "$(readlink -f "$candidate")" != "$launcher_path" ]; then
    alacritty_bin="$candidate"
  fi
fi

if [ -z "$alacritty_bin" ] && [ -x /usr/local/bin/alacritty ]; then
  alacritty_bin=/usr/local/bin/alacritty
fi

if [ -z "$alacritty_bin" ] && [ -x /usr/bin/alacritty ]; then
  alacritty_bin=/usr/bin/alacritty
fi

if [ -n "$alacritty_bin" ] && [ -x "$alacritty_bin" ]; then
  exec "$alacritty_bin" --config-file "$root_dir/alacritty/alacritty.toml" "$@"
fi

if command -v flatpak >/dev/null 2>&1 && flatpak info org.alacritty.Alacritty >/dev/null 2>&1; then
  exec flatpak run --filesystem="$root_dir:ro" org.alacritty.Alacritty \
    --config-file "$root_dir/alacritty/alacritty.toml" "$@"
fi

printf 'Alacritty not found. Set ALACRITTY_BIN, add it to PATH, or install the org.alacritty.Alacritty Flatpak.\n' >&2
exit 1
